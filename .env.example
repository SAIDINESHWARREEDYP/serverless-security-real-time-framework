# ==============================================================================
# Environment Configuration Template for Serverless Security Verification Framework
# All values are placeholders only. Never commit production secrets.
# ==============================================================================

# Application Environment ('development' or 'production')
NODE_ENV="development"

# Server Port
PORT=3000

# High-Entropy JWT HMAC-SHA256 Signing Secret (Minimum 32 characters in production)
# Secret Rotation Guideline: Rotate every 90 days; invalidate existing sessions upon rotation.
JWT_SECRET="PLACEHOLDER_ENTERPRISE_JWT_SECRET_MIN_32_CHARS_REPLACE_IN_PRODUCTION"

# Public App Origin (used for CORS verification and secure redirect checks)
APP_URL="https://serverless-securityverification.ai.studio"

# Explicit Trusted Origin for Cloudflare Workers Edge Mesh
ZERO_TRUST_ORIGIN="https://serverless-securityverification.ai.studio"

# AI Studio injected key for optional Gemini security threat scans
GEMINI_API_KEY="MY_GEMINI_API_KEY"
